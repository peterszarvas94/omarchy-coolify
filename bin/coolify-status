#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-coolify"
mkdir -p "$cache"
exec 9>"$cache/build.lock"
flock 9
cd "$root"
fingerprint=$({ printf 'go.mod\0'; find cmd/coolify-status -name '*.go' ! -name '*_test.go' -print0; } | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
if [[ ! -x "$cache/coolify-status" || ! -f "$cache/source.sha256" || "$(cat "$cache/source.sha256")" != "$fingerprint" ]]; then
  go build -trimpath -o "$cache/coolify-status.new" ./cmd/coolify-status
  mv "$cache/coolify-status.new" "$cache/coolify-status"
  printf '%s' "$fingerprint" > "$cache/source.sha256"
fi
flock -u 9
export OMARCHY_COOLIFY_ICON="$root/assets/coolify-notification.svg"
exec "$cache/coolify-status" "$@"
